# Copy to a file named .env (never commit it) to switch the app from the demo to the live sign-in.
# Both values: Supabase dashboard -> Project Settings -> API Keys. Use a dedicated Academy project.
# VITE_ values are public and end up in the browser bundle: only the PUBLISHABLE key belongs here.
VITE_ACADEMY_SUPABASE_URL=https://txwremmzgnmlnklpeton.supabase.co
VITE_ACADEMY_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# NEVER put sb_secret_*, service_role keys or database passwords in this file.

# Phone alerts (optional, docs/PUSH_ALERTS.md): the PUBLIC half of the VAPID key pair. The private half goes only into
# Supabase Edge Function secrets, never here.
# VITE_ACADEMY_VAPID_PUBLIC_KEY=B...
